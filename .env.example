# 3DPrintTally configuration. Copy to .env and edit.
#   cp .env.example .env
# Never commit .env — it is listed in .gitignore.

# ── Basics ────────────────────────────────────────────────────────────────
# Timezone for timestamps, backup filenames and the daily backup schedule.
TZ=UTC

# The UID/GID that owns data/ and backups/ on the host. Run `id -u` and `id -g`.
# The one-shot volume-permissions service chowns the bind mounts to match, so the
# app can run as a non-root user without permission errors.
APP_UID=1000
APP_GID=1000

# ── Network exposure ──────────────────────────────────────────────────────
# Host address and port the app binds to.
#
# BIND_ADDRESS defaults to 127.0.0.1 — reachable only from the machine running
# it. This is deliberate: authentication below is OFF by default, so a wider
# bind puts an unauthenticated admin UI on your network.
#
# Set 0.0.0.0 only when you have EITHER configured BASIC_AUTH_* below, OR put
# the app behind a reverse proxy / VPN that authenticates for you.
BIND_ADDRESS=127.0.0.1
APP_PORT=8091

# Optional Host-header allowlist, comma separated. Blank accepts any hostname,
# which is the right setting behind a proxy that already filters them.
# localhost and 127.0.0.1 are always included when this is set.
# Example: TRUSTED_HOSTS=tally.example.com,tally.lan
TRUSTED_HOSTS=

# Set 1 when the app is reached over HTTPS only. Keep 0 for plain HTTP on a LAN,
# or session cookies will be dropped by the browser and logins will not stick.
COOKIE_SECURE=0

# ── Authentication ────────────────────────────────────────────────────────
# Optional HTTP Basic auth. Configure BOTH values or NEITHER — setting only one
# is a startup error, on purpose.
#
# Generate the hash (never store a plaintext password here):
#   python3 tools/password_hash.py
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD_HASH=

# ── Sessions ──────────────────────────────────────────────────────────────
# Leave blank and a random key is generated once at data/.session-key and reused
# across restarts. Set it explicitly only if you run multiple app instances
# against the same database and need them to share sessions.
# SECRET_KEY=

# ── Paths ─────────────────────────────────────────────────────────────────
# Override where the SQLite database and product photos live. Defaults to ./data
# inside the container, which is bind-mounted from ./data on the host.
# TALLY_DATA_DIR=/app/data
